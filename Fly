-- BUCLE DE RENDIMIENTO Y VUELO
local lastTime = tick()
local frameCount = 0

RunService.RenderStepped:Connect(function()
	local hue = (tick() * 0.5) % 1
	local rainbowColor = Color3.fromHSV(hue, 1, 1)
	
	if player.Character and player.Character:FindFirstChild("Head") then
		local tag = player.Character.Head:FindFirstChild("XZOmegaOverhead")
		if tag and tag:FindFirstChild("RainbowLabel") then
			tag.RainbowLabel.TextColor3 = rainbowColor
		end
	end
	
	frameCount = frameCount + 1
	if tick() - lastTime >= 1 then
		local fps = frameCount
		frameCount = 0
		lastTime = tick()
		
		local pingMs = 0
		pcall(function()
			pingMs = math.floor(player:GetNetworkPing() * 1000)
		end)
		
		statusLabel.Text = "🟢 FPS: " .. fps .. " | ⚡ Ping: " .. pingMs .. " ms | 👤 " .. player.Name
		
		local flyStatus = flying and "[ENCENDIDO]" or "[APAGADO]"
		infoLabel.Text = player.Name .. "\nFly: " .. flyStatus .. " | Ping: " .. pingMs .. " ms | FPS: " .. fps
	end
	
	if flying and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
		local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
		bodyGyro.CFrame = camera.CFrame
		
		local moveDir = humanoid and humanoid.MoveDirection or Vector3.zero
		local vMove = 0
		if upPressed then vMove = 1 end
		if downPressed or autoBajar then vMove = -1 end
		
		bodyVelocity.Velocity = (moveDir * flySpeed) + Vector3.new(0, vMove * flySpeed, 0)
	end
end)


