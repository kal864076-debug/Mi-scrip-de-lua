	local t2 = Instance.new("TextLabel", toast)
	t2.Size = UDim2.new(1, -14, 0, 18)
	t2.Position = UDim2.new(0, 12, 0, 26)
	t2.BackgroundTransparency = 1
	t2.Text = msg
	t2.TextColor3 = THEME.TextMain
	t2.Font = Enum.Font.Gotham
	t2.TextSize = 11
	t2.TextXAlignment = Enum.TextXAlignment.Left

	tween(toast, 0.35, {Position = UDim2.new(1, -270, 0.82, 0)}, Enum.EasingStyle.Back)
	task.delay(2.8, function()
		local out = tween(toast, 0.3, {Position = UDim2.new(1, 20, 0.82, 0)}, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		out.Completed:Connect(function() toast:Destroy() end)
	end)
end

local function cambiarTema(nombreColor)
	local palette = PALETTES[nombreColor]
	if not palette then return end
	THEME.Accent = palette.Accent
	THEME.Border = palette.Border

	for _, item in ipairs(colorables) do
		if item.Type == "Stroke" and item.Obj then
			item.Obj.Color = THEME.Border
		elseif item.Type == "AccentStroke" and item.Obj then
			item.Obj.Color = THEME.Accent
		elseif item.Type == "Text" and item.Obj then
			item.Obj.TextColor3 = THEME.Accent
		elseif item.Type == "ScrollBar" and item.Obj then
			item.Obj.ScrollBarImageColor3 = THEME.Accent
		end
	end
	notificar("Tema", "Color cambiado a " .. nombreColor, "success")
end

local function quitarMarcador()
	if rotacion then rotacion:Disconnect() rotacion = nil end
	if marcador then marcador:Destroy() marcador = nil end
end

local function crearMarcador(cf, color)
	quitarMarcador()
	local model = Instance.new("Model")
	model.Name = "XZ_TP_Marker_Premium"

	local part = Instance.new("Part")
	part.Size = Vector3.new(1.8, 1.8, 1.8)
	part.CFrame = cf * CFrame.new(0, 2.8, 0)
	part.Anchored = true
	part.CanCollide = false
	part.Material = Enum.Material.Neon
	part.Color = color
	part.Transparency = 0.15
	part.Parent = model

	model.Parent = Workspace
	marcador = model

	local ang = 0
	rotacion = RunService.RenderStepped:Connect(function(dt)
		if part and part.Parent then
			ang = ang + dt * 85
			part.CFrame = (cf * CFrame.new(0, 2.8 + math.sin(os.clock()*3)*0.35, 0)) * CFrame.Angles(0, math.rad(ang), 0)
		end
	end)
end

local function hover(btn, normal, over)
	btn.MouseEnter:Connect(function() tween(btn, 0.15, {BackgroundColor3 = over}) end)
	btn.MouseLeave:Connect(function() tween(btn, 0.15, {BackgroundColor3 = normal}) end)
end

