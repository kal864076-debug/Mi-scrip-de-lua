	t1.TextColor3 = color
	t1.Font = Enum.Font.RobotoMono
	t1.TextSize = 10
	t1.TextXAlignment = Enum.TextXAlignment.Left

	local t2 = Instance.new("TextLabel", toast)
	t2.Size = UDim2.new(1, -12, 0, 28)
	t2.Position = UDim2.new(0, 8, 0, 20)
	t2.BackgroundTransparency = 1
	t2.Text = msg
	t2.TextColor3 = THEME.TextMain
	t2.Font = Enum.Font.Gotham
	t2.TextSize = 8
	t2.TextWrapped = true
	t2.TextXAlignment = Enum.TextXAlignment.Left

	tween(toast, 0.35, {Position = UDim2.new(1, -255, 0.78, 0)}, Enum.EasingStyle.Back)
	task.delay(duracion, function()
		local out = tween(toast, 0.3, {Position = UDim2.new(1, 20, 0.78, 0)}, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		out.Completed:Connect(function() toast:Destroy() end)
	end)
end

local function hover(btn, normal, over)
	btn.MouseEnter:Connect(function() tween(btn, 0.15, {BackgroundColor3 = over}) end)
	btn.MouseLeave:Connect(function() tween(btn, 0.15, {BackgroundColor3 = normal}) end)
end

