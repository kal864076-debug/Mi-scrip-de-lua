local function crearTarjetaToggle(titulo, sub, colorActivo)
	colorActivo = colorActivo or THEME.Accent
	local card = crearTarjetaBase(titulo, sub)

	local switchBg = Instance.new("TextButton", card)
	switchBg.Size = UDim2.new(0, 40, 0, 22)
	switchBg.Position = UDim2.new(1, -48, 0.5, -11)
	switchBg.BackgroundColor3 = THEME.BgSidebar
	switchBg.Text = ""
	switchBg.AutoButtonColor = false
	Instance.new("UICorner", switchBg).CornerRadius = UDim.new(0, 5)

	local switchStroke = Instance.new("UIStroke", switchBg)
	switchStroke.Color = THEME.Border
	switchStroke.Thickness = 1

	local knob = Instance.new("Frame", switchBg)
	knob.Size = UDim2.new(0, 14, 0, 16)
	knob.Position = UDim2.new(0, 3, 0.5, -8)
	knob.BackgroundColor3 = colorActivo
	knob.BorderSizePixel = 0
	Instance.new("UICorner", knob).CornerRadius = UDim.new(0, 4)

	local estado = false

	local function setEstado(nuevoEstado)
		estado = nuevoEstado
		if estado then
			tween(switchBg, 0.22, {BackgroundColor3 = colorActivo})
			switchStroke.Color = colorActivo
			knob.BackgroundColor3 = THEME.BgPrimary
			tween(knob, 0.22, {Position = UDim2.new(1, -17, 0.5, -8)})
		else
			tween(switchBg, 0.22, {BackgroundColor3 = THEME.BgSidebar})
			switchStroke.Color = THEME.Border
			knob.BackgroundColor3 = colorActivo
			tween(knob, 0.22, {Position = UDim2.new(0, 3, 0.5, -8)})
		end
	end

	return card, switchBg, setEstado
end

