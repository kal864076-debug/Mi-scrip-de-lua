local function setupOverheadTag(character)
	local head = character:WaitForChild("Head", 5)
	local humanoid = character:WaitForChild("Humanoid", 5)
	if not head then return end
	
	if humanoid then
		humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	end
	
	if head:FindFirstChild("XZOmegaOverhead") then
		head.XZOmegaOverhead:Destroy()
	end
	
	local billboard = Instance.new("BillboardGui")
	billboard.Name = "XZOmegaOverhead"
	billboard.Size = UDim2.new(0, 220, 0, 60)
	billboard.StudsOffset = Vector3.new(0, 2.8, 0)
	billboard.AlwaysOnTop = true
	billboard.Parent = head
	
	local nameLabel = Instance.new("TextLabel")
	nameLabel.Name = "RainbowLabel"
	nameLabel.Size = UDim2.new(1, 0, 1, 0)
	nameLabel.BackgroundTransparency = 1
	nameLabel.Text = "👑 XZ OMEGA [VIP]"
	nameLabel.TextSize = 20
	nameLabel.Font = Enum.Font.GothamBold
	nameLabel.TextStrokeTransparency = 0
	nameLabel.TextStrokeColor3 = Color3.fromRGB(40, 10, 60)
	nameLabel.Parent = billboard
end

if player.Character then setupOverheadTag(player.Character) end
player.CharacterAdded:Connect(function(char)
