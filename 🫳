-- BUCLE PRINCIPAL PARA EL VUELO CON VELOCIDAD MODIFICABLE Y DIRECCIONES
RunService.RenderStepped:Connect(function()
	if flying and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
		bodyGyro.CFrame = camera.CFrame
		
		local vMove = 0
		if upPressed then vMove = 1 end
		if downPressed then vMove = -1 end
		
		local hMove = 0
		if forwardPressed then hMove = 1 end
		if backwardPressed then hMove = -1 end
		
		local lookVector = camera.CFrame.LookVector
		local moveDir = Vector3.new(0, vMove, 0)
		if hMove ~= 0 then
			moveDir = moveDir + (lookVector * hMove)
		end
		
		bodyVelocity.Velocity = moveDir * flySpeed
	end
end)

