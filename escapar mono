-- TABS
local tabs = {}
local function crearTabButton(nombre, icono, paginaAsociada, activoInicial)
	local btn = Instance.new("TextButton", sidebar)
	btn.Size = UDim2.new(1, 0, 0, 32)
	btn.BackgroundColor3 = activoInicial and THEME.BgCard or THEME.BgSidebar
	btn.Text = " " .. icono .. " " .. nombre
	btn.TextColor3 = activoInicial and THEME.Accent or THEME.TextSub
	btn.Font = Enum.Font.RobotoMono
	btn.TextSize = 10
	btn.TextXAlignment = Enum.TextXAlignment.Left
	Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 5)

	local stroke = Instance.new("UIStroke", btn)
	stroke.Color = THEME.Accent
	stroke.Thickness = 1
	stroke.Enabled = activoInicial

	table.insert(tabs, {Button = btn, Stroke = stroke, Page = paginaAsociada})

	btn.MouseButton1Click:Connect(function()
		for _, tabData in ipairs(tabs) do
			local esActiva = (tabData.Button == btn)
			tabData.Page.Visible = esActiva
			tabData.Button.BackgroundColor3 = esActiva and THEME.BgCard or THEME.BgSidebar
			tabData.Button.TextColor3 = esActiva and THEME.Accent or THEME.TextSub
			tabData.Stroke.Enabled = esActiva
		end
	end)
end

