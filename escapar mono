-- === MARCADOR 3D ===
local function quitarMarcador()
	if rotacion then rotacion:Disconnect() rotacion = nil end
	if marcador then marcador:Destroy() marcador = nil end
end

local function crearMarcador(cf, color)
	quitarMarcador()
	local model = Instance.new("Model")
	model.Name = "XZ_TP_Marker"

	local part = Instance.new("Part")
	part.Size = Vector3.new(1.8, 1.8, 1.8)
	part.CFrame = cf * CFrame.new(0, 2.8, 0)
	part.Anchored = true
	part.CanCollide = false
	part.Material = Enum.Material.Neon
	part.Color = color
	part.Transparency = 0.15
	part.Parent = model

	model.Parent = Workspace
	marcador = model

	local ang = 0
	rotacion = RunService.RenderStepped:Connect(function(dt)
		if part and part.Parent then
			ang = ang + dt * 85
			part.CFrame = (cf * CFrame.new(0, 2.8 + math.sin(os.clock()*3)*0.35, 0)) * CFrame.Angles(0, math.rad(ang), 0)
		end
	end)
end

