local function getRoot()
	local c = LocalPlayer.Character
	return c and c:FindFirstChild("HumanoidRootPart")
end

-- Obtener Checkpoint 1 al 9 del Mundo 4
local function obtenerHitboxCheckpointMundo4(numEtapa)
	local ok, res = pcall(function()
		local checkpointObj = Workspace.Map.Checkpoints.World4:FindFirstChild("Checkpoint" .. numEtapa)
		if checkpointObj then
			local hitbox = checkpointObj:FindFirstChild("Hitbox")
			if hitbox and hitbox:IsA("BasePart") then
				return hitbox.CFrame + Vector3.new(0, 3, 0)
			end
		end
		return nil
	end)
	if ok and res then return res end
	return nil
end

-- Obtener workspace.Map.World4.Stages.Stage9.StageEnd.Part
local function obtenerPosicionStageEndPart()
	local ok, res = pcall(function()
		local partObj = Workspace.Map.World4.Stages.Stage9.StageEnd.Part
		if partObj and partObj:IsA("BasePart") then
			return partObj.CFrame + Vector3.new(0, 3, 0)
		end
		return nil
	end)
	if ok and res then return res end
	return nil
end

-- Obtener workspace.Map.World4.Stages.Stage9.NormalWin.UI (Etapa 10 final / Farm)
local function obtenerPosicionNormalWinUI()
	local ok, res = pcall(function()
		local uiObj = Workspace.Map.World4.Stages.Stage9.NormalWin.UI
		if uiObj:IsA("BasePart") then
			return uiObj.CFrame + Vector3.new(0, 3, 0)
		elseif uiObj:IsA("Model") then
			local p = uiObj:FindFirstChildWhichIsA("BasePart", true)
			return p and (p.CFrame + Vector3.new(0, 3, 0)) or uiObj:GetPivot()
		end
		return nil
	end)
	if ok and res then return res end
	return nil
end

local teleguiadoActivo = false
local hiloSecuencia = nil

local function actualizarSwitchVisual(estado)
	if estado then
		tween(switchBg, 0.22, {BackgroundColor3 = THEME.Success})
		switchStroke.Color = THEME.Success
		knob.BackgroundColor3 = THEME.BgCard
		tween(knob, 0.22, {Position = UDim2.new(1, -19, 0.5, -8)})
	else
		tween(switchBg, 0.22, {BackgroundColor3 = Color3.fromRGB(35, 45, 35)})
		switchStroke.Color = Color3.fromRGB(60, 80, 60)
		knob.BackgroundColor3 = THEME.TextSub
		tween(knob, 0.22, {Position = UDim2.new(0, 3, 0.5, -8)})
	end
end

switchBg.MouseButton1Click:Connect(function()
	teleguiadoActivo = not teleguiadoActivo
	actualizarSwitchVisual(teleguiadoActivo)
	
	reproducirSonido(teleguiadoActivo)

	if teleguiadoActivo then
		notificar("XZ OMEGA", "Iniciando recorrido (Velocidad 0.5s)...", "success", 3)
		
		hiloSecuencia = task.spawn(function()
			while teleguiadoActivo do
				-- 1. Recorrido secuencial Checkpoints 1 al 9 a velocidad 0.5 segundos exactos
				for i = 1, 9 do
					if not teleguiadoActivo then break end
					stageStatusLabel.Text = "Avanzando a: Checkpoint " .. i
					local pos = obtenerHitboxCheckpointMundo4(i)
					local root = getRoot()
					if root and pos then
						root.AssemblyLinearVelocity = Vector3.zero
						root.AssemblyAngularVelocity = Vector3.zero
						root.CFrame = pos
					end
					task.wait(0.5)
				end

				-- 2. Teletransportar a StageEnd Part
				if not teleguiadoActivo then break end
				stageStatusLabel.Text = "Llegando a StageEnd Part"
				local endPartPos = obtenerPosicionStageEndPart()
				local root = getRoot()
				if root and endPartPos then
					root.AssemblyLinearVelocity = Vector3.zero
					root.AssemblyAngularVelocity = Vector3.zero
					root.CFrame = endPartPos
				end
				task.wait(0.5)

				-- 3. Quedarse farmeando en NormalWin.UI (Última etapa 10)
				stageStatusLabel.Text = "Farm Activo: Etapa 10 (NormalWin.UI)"
				notificar("AUTOFARM", "¡En la última etapa! Farmeando en NormalWin.UI", "success", 2)
				while teleguiadoActivo do
					local finalRoot = getRoot()
					local finalPos = obtenerPosicionNormalWinUI()
					if finalRoot and finalPos then
						finalRoot.AssemblyLinearVelocity = Vector3.zero
						finalRoot.AssemblyAngularVelocity = Vector3.zero
						finalRoot.CFrame = finalPos
					end
					task.wait(0.3)
				end
			end
		end)
	else
		if hiloSecuencia then
			task.cancel(hiloSecuencia)
			hiloSecuencia = nil
		end
		stageStatusLabel.Text = "Inactivo / Esperando activación"
		notificar("XZ OMEGA", "Teleguiado desactivado.", "warning", 2)
	end
end)

local function togglePanel()
	panelAbierto = not panelAbierto
	if panelAbierto then
		mainFrame.Visible = true
		mainFrame.Size = UDim2.new(0, 0, 0, 0)
		mainFrame.Position = UDim2.new(0.5, 0, 0.5, 0)
		tween(mainFrame, 0.35, {
			Size = UDim2.new(0, 310, 0, 205),
			Position = UDim2.new(0.5, -155, 0.5, -102)
		}, Enum.EasingStyle.Back)
	else
		local a = tween(mainFrame, 0.25, {
			Size = UDim2.new(0, 0, 0, 0),
			Position = UDim2.new(0.5, 0, 0.5, 0)
		}, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
		a.Completed:Connect(function()
			if not panelAbierto then mainFrame.Visible = false end
		end)
	end
end

