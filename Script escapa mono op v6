local function crearSlider(titulo, sub, minVal, maxVal, inicio, callback)
	local card = Instance.new("Frame", contentContainer)
	card.Size = UDim2.new(1, -5, 0, 50)
	card.BackgroundColor3 = THEME.BgCard
	card.BorderSizePixel = 0
	Instance.new("UICorner", card).CornerRadius = UDim.new(0, 8)

	local tLabel = Instance.new("TextLabel", card)
	tLabel.Size = UDim2.new(0, 150, 0, 18)
	tLabel.Position = UDim2.new(0, 12, 0, 6)
	tLabel.BackgroundTransparency = 1
	tLabel.Text = titulo
	tLabel.TextColor3 = THEME.TextMain
	tLabel.Font = Enum.Font.GothamBold
	tLabel.TextSize = 12
	tLabel.TextXAlignment = Enum.TextXAlignment.Left

	local sLabel = Instance.new("TextLabel", card)
	sLabel.Size = UDim2.new(0, 180, 0, 14)
	sLabel.Position = UDim2.new(0, 12, 0, 26)
	sLabel.BackgroundTransparency = 1
	sLabel.Text = sub
	sLabel.TextColor3 = THEME.TextSub
	sLabel.Font = Enum.Font.Gotham
	sLabel.TextSize = 10
	sLabel.TextXAlignment = Enum.TextXAlignment.Left

	local valLabel = Instance.new("TextLabel", card)
	valLabel.Size = UDim2.new(0, 35, 0, 18)
	valLabel.Position = UDim2.new(1, -145, 0, 16)
	valLabel.BackgroundTransparency = 1
	valLabel.Text = tostring(inicio)
	valLabel.TextColor3 = THEME.TextSub
	valLabel.Font = Enum.Font.Gotham
	valLabel.TextSize = 11

	local sliderTrack = Instance.new("Frame", card)
	sliderTrack.Size = UDim2.new(0, 100, 0, 3)
	sliderTrack.Position = UDim2.new(1, -110, 0.5, -1)
	sliderTrack.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
	sliderTrack.BorderSizePixel = 0

	local pctInicial = math.clamp((inicio - minVal) / (maxVal - minVal), 0, 1)

	local sliderKnob = Instance.new("ImageButton", sliderTrack)
	sliderKnob.Size = UDim2.new(0, 12, 0, 12)
	sliderKnob.Position = UDim2.new(pctInicial, -6, 0.5, -6)
	sliderKnob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	sliderKnob.BorderSizePixel = 0
	Instance.new("UICorner", sliderKnob).CornerRadius = UDim.new(1, 0)

	local arrastrando = false

	local function actualizar(input)
		local posX = math.clamp((input.Position.X - sliderTrack.AbsolutePosition.X) / sliderTrack.AbsoluteSize.X, 0, 1)
		sliderKnob.Position = UDim2.new(posX, -6, 0.5, -6)
		local valor = math.floor(minVal + (maxVal - minVal) * posX)
		valLabel.Text = tostring(valor)
		callback(valor)
	end

	sliderKnob.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			arrastrando = true
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			arrastrando = false
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if arrastrando and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			actualizar(input)
		end
	end)
end

