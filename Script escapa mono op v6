	switchBg.Size = UDim2.new(0, 42, 0, 22)
	switchBg.Position = UDim2.new(1, -52, 0.5, -11)
	switchBg.BackgroundColor3 = valorInicial and THEME.Accent or Color3.fromRGB(45, 45, 45)
