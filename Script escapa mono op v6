local function togglePanel()
	panelAbierto = not panelAbierto
	if panelAbierto then
		mainFrame.Visible = true
		mainFrame.Size = UDim2.new(0, 0, 0, 0)
		mainFrame.Position = UDim2.new(0.5, 0, 0.5, 0)
		tween(mainFrame, 0.35, {
			Size = UDim2.new(0, 520, 0, 320),
			Position = UDim2.new(0.5, -260, 0.5, -160)
		}, Enum.EasingStyle.Back)
	else
		local a = tween(mainFrame, 0.25, {
			Size = UDim2.new(0, 0, 0, 0),
			Position = UDim2.new(0.5, 0, 0.5, 0)
		}, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
		a.Completed:Connect(function()
			if not panelAbierto then mainFrame.Visible = false end
		end)
	end
end

btnAbrir.MouseButton1Click:Connect(togglePanel)
btnCerrar.MouseButton1Click:Connect(togglePanel)

local function getRoot()
	local c = LocalPlayer.Character
	return c and c:FindFirstChild("HumanoidRootPart")
end

-- TP 1
btnG1.MouseButton1Click:Connect(function()
	local root = getRoot()
	if not root then return notificar("Error", "Personaje no encontrado", "error") end
	pos1 = root.CFrame
	crearMarcador(pos1, THEME.Accent)
	btnG1.Text = "SET!"
	tween(btnG1, 0.2, {BackgroundColor3 = THEME.Success, TextColor3 = Color3.new(0,0,0)})
	notificar("TP 1", "Posición guardada", "tp")
	task.wait(1)
	btnG1.Text = "RE-SET"
	tween(btnG1, 0.2, {BackgroundColor3 = Color3.fromRGB(40, 40, 40), TextColor3 = THEME.TextSub})
end)

local function iniciar1()
	hilo1 = task.spawn(function()
		while bucle1 do
			local root = getRoot()
			if root and pos1 then root.CFrame = pos1 end
			local t = tonumber(input1.Text) or 1
			if t < 0.1 then t = 0.1 end
			local pasos = math.max(1, math.floor(t * 10))
			for i = pasos, 1, -1 do
				if not bucle1 then break end
				task.wait(t / pasos)
			end
		end
	end)
end

btnB1.MouseButton1Click:Connect(function()
	if not pos1 and not bucle1 then
		return notificar("Atención", "Guarda TP 1 primero", "warning")
	end
	bucle1 = not bucle1
	if bucle1 then
		btnB1.Text = "ON"
		tween(btnB1, 0.2, {BackgroundColor3 = THEME.Accent, TextColor3 = Color3.new(1,1,1)})
		fI1.Visible = true
		iniciar1()
		notificar("Auto TP 1", "Activado", "success")
	else
		btnB1.Text = "OFF"
		tween(btnB1, 0.2, {BackgroundColor3 = Color3.fromRGB(40, 40, 40), TextColor3 = THEME.TextSub})
		fI1.Visible = false
		if hilo1 then task.cancel(hilo1) hilo1 = nil end
		notificar("Auto TP 1", "Desactivado", "warning")
	end
end)

