local function obtenerEtapaActualJugador()
	local stats = LocalPlayer:FindFirstChild("leaderstats") or LocalPlayer:FindFirstChild("stats")
	if stats then
		local stageVal = stats:FindFirstChild("Stage") 
			or stats:FindFirstChild("StageValue") 
			or stats:FindFirstChild("Level") 
			or stats:FindFirstChild("Etapa")
		if stageVal then
			return tonumber(stageVal.Value)
		end
	end
	return nil
end

