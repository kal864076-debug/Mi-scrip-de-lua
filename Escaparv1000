local function desactivarOtrosMundos(idxExcluido)
	for i = 1, 5 do
		if i ~= idxExcluido and mundosData[i] then
			if mundosData[i].bucle then
				mundosData[i].bucle = false
				mundosData[i].setSwitch(false)
				mundosData[i].fI.Visible = false
				if mundosData[i].hilo then
					task.cancel(mundosData[i].hilo)
					mundosData[i].hilo = nil
				end
			end
		end
	end
end

for i = 1, 5 do
	local colorTema = (i % 2 == 0) and THEME.Accent2 or THEME.Accent
	local subTexto = (i == 5) and "TP a Etapa (1-6)" or "TP a Etapa (1-10)"
	local card, switchBtn, setSwitch = crearTarjetaToggle("Mundo " .. i, subTexto, colorTema)
	local fI, boxVel, boxEtapa = crearTarjetaOpciones(i)

	mundosData[i] = {
		bucle = false,
		hilo = nil,
		setSwitch = setSwitch,
		fI = fI,
		boxVel = boxVel,
		boxEtapa = boxEtapa
	}

	switchBtn.MouseButton1Click:Connect(function()
		local data = mundosData[i]
		data.bucle = not data.bucle
		setSwitch(data.bucle)

		if data.bucle then
			desactivarOtrosMundos(i)
			data.fI.Visible = true

			local etapaDetectada = obtenerEtapaActualJugador()
			if etapaDetectada then
				data.boxEtapa.Text = tostring(etapaDetectada)
			end

			local etapaSel = tonumber(data.boxEtapa.Text) or 1
			MoverAEtapa(i, etapaSel)

			data.hilo = task.spawn(function()
				while data.bucle do
					local e = tonumber(data.boxEtapa.Text) or 1
					MoverAEtapa(i, e)

					local t = tonumber(data.boxVel.Text) or tonumber(inputVelocidadGlobal.Text) or 0
					if t <= 0 then
						task.wait()
					else
						task.wait(t)
					end
				end
			end)

			notificar("TP M" .. i, "Teletransportando a Etapa " .. data.boxEtapa.Text, "success", 3)
		else
			data.fI.Visible = false
			if data.hilo then
				task.cancel(data.hilo)
				data.hilo = nil
			end
			notificar("Auto TP M" .. i, "Desactivado", "warning", 3)
		end
	end)
end

