local function getRoot()
	local c = LocalPlayer.Character
	return c and c:FindFirstChild("HumanoidRootPart")
end

local function obtenerPosicionEtapa(numMundo, numEtapa)
	local ok, res = pcall(function()
		local map = Workspace:FindFirstChild("Map") or Workspace
		local world = map:FindFirstChild("World" .. numMundo) 
			or map:FindFirstChild("World " .. numMundo) 
			or map

		local nombresPosibles = {
			"Stage" .. numEtapa, "Stage " .. numEtapa, "Stage_" .. numEtapa,
			"Etapa" .. numEtapa, "Etapa " .. numEtapa, "Checkpoint" .. numEtapa,
			"Checkpoint " .. numEtapa, tostring(numEtapa)
		}

		local stageObj = nil
		local stagesFolder = world:FindFirstChild("Stages") or world:FindFirstChild("Checkpoints") or world

		for _, nombre in ipairs(nombresPosibles) do
			stageObj = stagesFolder:FindFirstChild(nombre, true)
			if stageObj then break end
		end

		if not stageObj then return nil end

		local winObj = stageObj:FindFirstChild("NormalWin", true) 
			or stageObj:FindFirstChild("UI", true) 
			or stageObj:FindFirstChild("Win", true) 
			or stageObj

		if winObj:IsA("Model") then
			local p = winObj:FindFirstChildWhichIsA("BasePart", true)
			return p and p.CFrame or winObj:GetPivot()
		elseif winObj:IsA("BasePart") then
			return winObj.CFrame
		end

		return nil
	end)

	if ok and res then
		return res + Vector3.new(0, 3.5, 0)
	end
	return nil
end

local function MoverAEtapa(numMundo, numEtapa)
	local root = getRoot()
	if not root then return end
	
	local pos = obtenerPosicionEtapa(numMundo, numEtapa)
	if pos then
		root.AssemblyLinearVelocity = Vector3.zero
		root.CFrame = pos
	end
end

