local function iniciar1()
	hilo1 = task.spawn(function()
		while bucle1 do
			local root = getRoot()
			if root and pos1 then root.CFrame = pos1 end
			
			local t = tonumber(input1.Text) or 1
			if superVelGlobal then
				t = 0.001
			end
			if t < 0.001 then t = 0.001 end
			
			task.wait(t)
		end
	end)
end

btnB1.MouseButton1Click:Connect(function()
