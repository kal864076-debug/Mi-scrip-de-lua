	else
		fI1.Visible = false
		if hilo1 then task.cancel(hilo1) hilo1 = nil end
		notificar("Auto TP 1", "Bucle desactivado", "warning")
	end
end)

-- MUNDO 5 (WORKSPACE.MAP.WORLD5.STAGES.STAGE3.NORMALWIN.UI)
local function obtenerPosicionW5UI()
	local ok, res = pcall(function()
		local target = Workspace.Map.World5.Stages.Stage3.NormalWin.UI
		if target:IsA("Model") then
			return target:GetPivot()
		else
			return target.CFrame
		end
	end)
	if ok and res then
		return res + Vector3.new(0, 3, 0)
	end
	return nil
end

local function iniciar2()
	hilo2 = task.spawn(function()
		while bucle2 do
			local root = getRoot()
			local targetCF = obtenerPosicionW5UI()
			if root and targetCF then
				root.CFrame = targetCF
			end
			
			local t = tonumber(input2.Text) or 1
			if superVelGlobal then
				t = 0.001
			end
			if t < 0.001 then t = 0.001 end
			
			task.wait(t)
		end
	end)
end

