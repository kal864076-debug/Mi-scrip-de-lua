local function crearTarjetaToggle(titulo, sub, colorActivo)
	colorActivo = colorActivo or THEME.Accent
	local card = crearTarjetaBase(titulo, sub)

	local switchBg = Instance.new("TextButton", card)
	switchBg.Size = UDim2.new(0, 48, 0, 26)
	switchBg.Position = UDim2.new(1, -58, 0.5, -13)
	switchBg.BackgroundColor3 = Color3.fromRGB(20, 26, 36)
	switchBg.Text = ""
	switchBg.AutoButtonColor = false
	Instance.new("UICorner", switchBg).CornerRadius = UDim.new(0, 6)

	local switchStroke = Instance.new("UIStroke", switchBg)
	switchStroke.Color = Color3.fromRGB(45, 60, 80)
	switchStroke.Thickness = 1.2

	local knob = Instance.new("Frame", switchBg)
	knob.Size = UDim2.new(0, 18, 0, 20)
	knob.Position = UDim2.new(0, 3, 0.5, -10)
	knob.BackgroundColor3 = colorActivo
	knob.BorderSizePixel = 0
	Instance.new("UICorner", knob).CornerRadius = UDim.new(0, 4)

	local estado = false

	local function setEstado(nuevoEstado)
		estado = nuevoEstado
		if estado then
			tween(switchBg, 0.22, {BackgroundColor3 = colorActivo})
			switchStroke.Color = colorActivo
			knob.BackgroundColor3 = Color3.fromRGB(15, 18, 24)
			tween(knob, 0.22, {Position = UDim2.new(1, -21, 0.5, -10)})
		else
			tween(switchBg, 0.22, {BackgroundColor3 = Color3.fromRGB(20, 26, 36)})
			switchStroke.Color = Color3.fromRGB(45, 60, 80)
			knob.BackgroundColor3 = colorActivo
			tween(knob, 0.22, {Position = UDim2.new(0, 3, 0.5, -10)})
		end
	end

	return card, switchBg, setEstado
end

