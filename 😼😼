-- TARJETA 5: REPRODUCIR GRABACIÓN
local playCard = createCard("Reproducir Grabación", "Repite exactamente lo que grabaste", 5)
createToggle(playCard, false, function(state)
	if state then
		if #recordedPath > 0 then
			playingBack = true
			task.spawn(function()
				while playingBack do
					for _, cf in ipairs(recordedPath) do
						if not playingBack then break end
						if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
							player.Character.HumanoidRootPart.CFrame = cf
						end
						RunService.RenderStepped:Wait()
					end
					task.wait(0.5)
				end
			end)
		end
	else
		playingBack = false
	end
end)

