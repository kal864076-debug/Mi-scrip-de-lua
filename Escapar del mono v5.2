local function togglePanel()
	panelAbierto = not panelAbierto
	if panelAbierto then
		panel.Visible = true
		tween(panel, 0.4, {
			Size = UDim2.new(0, 320, 0, 320),
			Position = UDim2.new(0.5, -160, 0.5, -160)
		}, Enum.EasingStyle.Back)
	else
		local a = tween(panel, 0.3, {
			Size = UDim2.new(0, 0, 0, 0),
			Position = UDim2.new(0.5, 0, 0.5, 0)
		}, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
		a.Completed:Connect(function()
			if not panelAbierto then panel.Visible = false end
		end)
	end
end

btnAbrir.MouseButton1Click:Connect(togglePanel)
btnCerrar.MouseButton1Click:Connect(togglePanel)

-- === LÓGICA ===
local function getRoot()
	local c = LocalPlayer.Character
	return c and c:FindFirstChild("HumanoidRootPart")
end

-- Guardar TP 1
btnG1.MouseButton1Click:Connect(function()
	local root = getRoot()
	if not root then return notificar("Error", "Personaje no encontrado", "error") end
	pos1 = root.CFrame
	crearMarcador(pos1, THEME.Accent)
	btnG1.Text = "SET!"
	tween(btnG1, 0.2, {BackgroundColor3 = THEME.Success, TextColor3 = Color3.new(0,0,0)})
	notificar("TP 1", "Posición guardada", "tp")
	task.wait(1)
	btnG1.Text = "RE-SET"
	tween(btnG1, 0.2, {BackgroundColor3 = Color3.fromRGB(45, 20, 25), TextColor3 = THEME.TextSub})
end)

