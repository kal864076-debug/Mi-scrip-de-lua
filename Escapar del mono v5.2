	tween(panelBottom, 0.6, {Position = UDim2.new(0, 0, 1, 0)}, Enum.EasingStyle.Quart, Enum.EasingDirection.InOut)

	task.wait(0.6)
	cargaContainer:Destroy()

	btnAbrir.Visible = true
	togglePanel()
	notificar("escapa mono XZ 🥀 5.2v", "Sistema circular cargado", "success")
end)

