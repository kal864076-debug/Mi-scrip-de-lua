-- Auto TP 1
local function iniciar1()
	hilo1 = task.spawn(function()
		while bucle1 do
			local root = getRoot()
			if root and pos1 then root.CFrame = pos1 end
			local t = tonumber(input1.Text) or 1
			if t < 0.1 then t = 0.1 end
			local pasos = math.max(1, math.floor(t * 10))
			for i = pasos, 1, -1 do
				if not bucle1 then break end
				task.wait(t / pasos)
			end
		end
	end)
end

btnB1.MouseButton1Click:Connect(function()
	if not pos1 and not bucle1 then
		return notificar("Atención", "Guarda TP 1 primero", "warning")
	end
	bucle1 = not bucle1
	if bucle1 then
		btnB1.Text = "ON"
		tween(btnB1, 0.2, {BackgroundColor3 = THEME.Accent, TextColor3 = Color3.new(0,0,0)})
		fI1.Visible = true
		iniciar1()
		notificar("Auto TP 1", "Activado", "success")
	else
		btnB1.Text = "OFF"
		tween(btnB1, 0.2, {BackgroundColor3 = Color3.fromRGB(45, 20, 25), TextColor3 = THEME.TextSub})
		fI1.Visible = false
		if hilo1 then task.cancel(hilo1) hilo1 = nil end
		notificar("Auto TP 1", "Desactivado", "warning")
	end
end)

