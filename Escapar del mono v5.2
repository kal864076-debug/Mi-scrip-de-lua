-- === UTILIDADES ===
local function tween(obj, t, props, style, dir)
	style = style or Enum.EasingStyle.Quart
	dir = dir or Enum.EasingDirection.Out
	local a = TweenService:Create(obj, TweenInfo.new(t, style, dir), props)
	a:Play()
	return a
end

local function notificar(titulo, msg, tipo)
	local color = THEME.Accent
	local icon = "⚙️"
	if tipo == "success" then color = THEME.Success; icon = "✅"
	elseif tipo == "error" then color = THEME.Error; icon = "❌"
	elseif tipo == "warning" then color = THEME.Warning; icon = "⚠️"
	elseif tipo == "tp" then color = THEME.Accent2; icon = "📍"
	end

	local toast = Instance.new("Frame")
	toast.Size = UDim2.new(0, 250, 0, 48)
	toast.Position = UDim2.new(1, 20, 0.82, 0)
	toast.BackgroundColor3 = THEME.BgSecondary
	toast.BorderSizePixel = 0
	toast.Parent = screenGui
	Instance.new("UICorner", toast).CornerRadius = UDim.new(0, 10)

	local stroke = Instance.new("UIStroke", toast)
	stroke.Color = color
	stroke.Thickness = 1.5

	local t1 = Instance.new("TextLabel", toast)
	t1.Size = UDim2.new(1, -14, 0, 18)
	t1.Position = UDim2.new(0, 10, 0, 5)
	t1.BackgroundTransparency = 1
	t1.Text = icon .. "  " .. string.upper(titulo)
	t1.TextColor3 = color
	t1.Font = Enum.Font.GothamBold
	t1.TextSize = 11
	t1.TextXAlignment = Enum.TextXAlignment.Left

	local t2 = Instance.new("TextLabel", toast)
	t2.Size = UDim2.new(1, -14, 0, 18)
	t2.Position = UDim2.new(0, 10, 0, 24)
	t2.BackgroundTransparency = 1
	t2.Text = msg
	t2.TextColor3 = THEME.TextMain
	t2.Font = Enum.Font.Gotham
	t2.TextSize = 11
	t2.TextXAlignment = Enum.TextXAlignment.Left

	tween(toast, 0.35, {Position = UDim2.new(1, -270, 0.82, 0)}, Enum.EasingStyle.Back)
	task.delay(2.6, function()
		local out = tween(toast, 0.3, {Position = UDim2.new(1, 20, 0.82, 0)}, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		out.Completed:Connect(function() toast:Destroy() end)
	end)
end

local function quitarMarcador()
	if rotacion then rotacion:Disconnect() rotacion = nil end
	if marcador then marcador:Destroy() marcador = nil end
end

local function crearMarcador(cf, color)
	quitarMarcador()
	local model = Instance.new("Model")
	model.Name = "XZ_TP_Marker"

	local part = Instance.new("Part")
	part.Size = Vector3.new(1.5, 1.5, 1.5)
	part.CFrame = cf * CFrame.new(0, 2.5, 0)
	part.Anchored = true
	part.CanCollide = false
	part.Material = Enum.Material.Neon
	part.Color = color
	part.Transparency = 0.2
	part.Parent = model

	local mesh = Instance.new("SpecialMesh", part)
	mesh.MeshType = Enum.MeshType.FileMesh
	mesh.MeshId = "rbxassetid://10337144"
	mesh.Scale = Vector3.new(1.2, 2.0, 1.2)

	local ground = Instance.new("Part")
	ground.Size = Vector3.new(0.6, 0.1, 0.6)
	ground.CFrame = cf
	ground.Anchored = true
	ground.Transparency = 1
	ground.CanCollide = false
	ground.Parent = model

	local a0 = Instance.new("Attachment", part)
	local a1 = Instance.new("Attachment", ground)

	local beam = Instance.new("Beam", part)
	beam.Attachment0 = a0
	beam.Attachment1 = a1
	beam.Color = ColorSequence.new(color, THEME.Accent2)
	beam.Width0 = 0.9
	beam.Width1 = 0.07
	beam.FaceCamera = true

	local hl = Instance.new("Highlight", model)
	hl.FillColor = color
	hl.OutlineColor = Color3.new(1,1,1)
	hl.FillTransparency = 0.5

	model.Parent = Workspace
	marcador = model

	local ang = 0
	rotacion = RunService.RenderStepped:Connect(function(dt)
		if part and part.Parent then
			ang = ang + dt * 75
			part.CFrame = (cf * CFrame.new(0, 2.5 + math.sin(os.clock()*2.5)*0.28, 0)) * CFrame.Angles(0, math.rad(ang), 0)
		end
	end)
end

local function hover(btn, normal, over)
	btn.MouseEnter:Connect(function() tween(btn, 0.15, {BackgroundColor3 = over}) end)
	btn.MouseLeave:Connect(function() tween(btn, 0.15, {BackgroundColor3 = normal}) end)
end

