local function tween(obj, t, props, style, dir)
	style = style or Enum.EasingStyle.Quart
	dir = dir or Enum.EasingDirection.Out
	local a = TweenService:Create(obj, TweenInfo.new(t, style, dir), props)
	a:Play()
	return a
end

local function notificar(titulo, msg, tipo, duracion)
	duracion = duracion or 3
	local color = THEME.Accent
	local icon = "⚡"
	if tipo == "success" then color = THEME.Success; icon = "✨"
	elseif tipo == "error" then color = THEME.Error; icon = "🚨"
	elseif tipo == "warning" then color = THEME.Accent2; icon = "⚠️"
	elseif tipo == "tp" then color = THEME.Accent2; icon = "📍"
	end

	local toast = Instance.new("Frame")
	toast.Size = UDim2.new(0, 240, 0, 52)
	toast.Position = UDim2.new(1, 20, 0.78, 0)
	toast.BackgroundColor3 = THEME.BgCard
