-- BUCLE PRINCIPAL DE RENDIMIENTO Y VUELO
local lastTime = tick()
local frameCount = 0

RunService.RenderStepped:Connect(function()
	frameCount = frameCount + 1
	if tick() - lastTime >= 1 then
		local fps = frameCount
		frameCount = 0
		lastTime = tick()
		
		local pingMs = 0
		pcall(function()
			pingMs = math.floor(player:GetNetworkPing() * 1000)
		end)
		
		statusLabel.Text = "👑 VIP STATUS: ACTIVO | FPS: " .. fps .. " | Ping: " .. pingMs .. " ms"
		
		local flyStatus = flying and "ON" or "OFF"
		infoLabel.Text = player.Name .. "\n[VIP] Fly: " .. flyStatus .. " | Ping: " .. pingMs .. " ms"
	end
	
	if flying and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
		local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
		bodyGyro.CFrame = camera.CFrame
		
		local moveDir = humanoid and humanoid.MoveDirection or Vector3.zero
		local vMove = 0
		if upPressed then vMove = 1 end
		
		-- Velocidad de bajada aumentada a la velocidad de la luz (multiplicador x10)
		if downPressed or autoBajar then 
			vMove = -10 
		end
		
		bodyVelocity.Velocity = (moveDir * flySpeed) + Vector3.new(0, vMove * flySpeed, 0)
	end
end)
