local function getRoot()
	local c = LocalPlayer.Character
	return c and c:FindFirstChild("HumanoidRootPart")
end

-- TP 1
btnG1.MouseButton1Click:Connect(function()
	local root = getRoot()
	if not root then return notificar("Error", "Personaje no encontrado", "error") end
	pos1 = root.CFrame
	crearMarcador(pos1, THEME.Accent)
	btnG1.Text = "SAVED!"
	tween(btnG1, 0.2, {BackgroundColor3 = THEME.Success, TextColor3 = Color3.new(0,0,0)})
	notificar("TP 1", "Posición guardada correctamente", "tp")
	task.wait(1)
	btnG1.Text = "RE-SET"
	tween(btnG1, 0.2, {BackgroundColor3 = Color3.fromRGB(30, 38, 52), TextColor3 = THEME.Accent})
end)

local function iniciar1()
	hilo1 = task.spawn(function()
		while bucle1 do
			local root = getRoot()
			if root and pos1 then root.CFrame = pos1 end
			local t = tonumber(input1.Text) or 1
			if t < 0.1 then t = 0.1 end
			local pasos = math.max(1, math.floor(t * 10))
			for i = pasos, 1, -1 do
				if not bucle1 then break end
				task.wait(t / pasos)
			end
		end
	end)
end

