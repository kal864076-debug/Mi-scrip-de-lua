local function crearToggleRGB(titulo, valorInicial, callback)
	local container = Instance.new("Frame", contentContainer)
	container.Size = UDim2.new(1, -8, 0, 44)
	container.BackgroundTransparency = 1

	local tLabel = Instance.new("TextLabel", container)
	tLabel.Size = UDim2.new(0.35, 0, 1, 0)
	tLabel.Position = UDim2.new(0, 4, 0, 0)
	tLabel.BackgroundTransparency = 1
	tLabel.Text = titulo
	tLabel.TextColor3 = THEME.TextMain
	tLabel.Font = Enum.Font.GothamBold
	tLabel.TextSize = 13
	tLabel.TextXAlignment = Enum.TextXAlignment.Left

	local switchBg = Instance.new("TextButton", container)
	switchBg.Size = UDim2.new(0, 150, 0, 40)
	switchBg.Position = UDim2.new(1, -150, 0.5, -20)
	switchBg.BackgroundColor3 = THEME.BgPrimary
	switchBg.Text = ""
	switchBg.AutoButtonColor = false
	switchBg.ClipsDescendants = true
	Instance.new("UICorner", switchBg).CornerRadius = UDim.new(1, 0)

	local stroke = Instance.new("UIStroke", switchBg)
	stroke.Thickness = 2.5
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border

	local rainbowSequence = ColorSequence.new({
		ColorSequenceKeypoint.new(0.00, Color3.fromRGB(255, 0, 80)),
		ColorSequenceKeypoint.new(0.20, Color3.fromRGB(255, 200, 0)),
		ColorSequenceKeypoint.new(0.40, Color3.fromRGB(0, 255, 120)),
		ColorSequenceKeypoint.new(0.60, Color3.fromRGB(0, 200, 255)),
		ColorSequenceKeypoint.new(0.80, Color3.fromRGB(180, 0, 255)),
		ColorSequenceKeypoint.new(1.00, Color3.fromRGB(255, 0, 80))
	})

	local rainbowGradient = Instance.new("UIGradient", stroke)
	rainbowGradient.Color = rainbowSequence

	task.spawn(function()
		local rot = 0
		while switchBg and switchBg.Parent do
			rot = (rot + 3) % 360
			rainbowGradient.Rotation = rot
			task.wait(0.03)
		end
	end)

	local bgGradient = Instance.new("UIGradient", switchBg)
	bgGradient.Color = rainbowSequence
	bgGradient.Rotation = 45
	bgGradient.Enabled = valorInicial

	local stateLabel = Instance.new("TextLabel", switchBg)
	stateLabel.Size = UDim2.new(0, 95, 1, 0)
	stateLabel.Position = valorInicial and UDim2.new(0, 10, 0, 0) or UDim2.new(0, 46, 0, 0)
	stateLabel.BackgroundTransparency = 1
	stateLabel.Text = valorInicial and "ACTIVADO" or "DESACTIVADO"
	stateLabel.TextColor3 = valorInicial and Color3.fromRGB(120, 255, 120) or Color3.fromRGB(240, 240, 250)
	stateLabel.Font = Enum.Font.FredokaOne
	stateLabel.TextSize = 11
	stateLabel.ZIndex = 2

	local knob = Instance.new("Frame", switchBg)
	knob.Size = UDim2.new(0, 34, 0, 34)
	knob.Position = valorInicial and UDim2.new(1, -37, 0.5, -17) or UDim2.new(0, 3, 0.5, -17)
	knob.BackgroundColor3 = Color3.fromRGB(18, 18, 26)
	knob.ZIndex = 3
	Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)

	local knobStroke = Instance.new("UIStroke", knob)
	knobStroke.Thickness = 2
	knobStroke.Color = valorInicial and Color3.fromRGB(0, 255, 120) or Color3.fromRGB(255, 0, 80)

	local powerIcon = Instance.new("TextLabel", knob)
	powerIcon.Size = UDim2.new(1, 0, 1, 0)
	powerIcon.BackgroundTransparency = 1
	powerIcon.Text = "⏻"
	powerIcon.TextColor3 = valorInicial and Color3.fromRGB(0, 255, 120) or Color3.fromRGB(220, 220, 220)
	powerIcon.Font = Enum.Font.GothamBold
	powerIcon.TextSize = 18

	local estado = valorInicial
	switchBg.MouseButton1Click:Connect(function()
		estado = not estado
		bgGradient.Enabled = estado

		if estado then
			tween(knob, 0.25, {Position = UDim2.new(1, -37, 0.5, -17)})
			tween(stateLabel, 0.25, {Position = UDim2.new(0, 10, 0, 0)})
			stateLabel.Text = "ACTIVADO"
			stateLabel.TextColor3 = Color3.fromRGB(120, 255, 120)
			knobStroke.Color = Color3.fromRGB(0, 255, 120)
			powerIcon.TextColor3 = Color3.fromRGB(0, 255, 120)
		else
			tween(knob, 0.25, {Position = UDim2.new(0, 3, 0.5, -17)})
			tween(stateLabel, 0.25, {Position = UDim2.new(0, 46, 0, 0)})
			stateLabel.Text = "DESACTIVADO"
			stateLabel.TextColor3 = Color3.fromRGB(240, 240, 250)
			knobStroke.Color = Color3.fromRGB(255, 0, 80)
			powerIcon.TextColor3 = Color3.fromRGB(220, 220, 220)
		end
		callback(estado)
	end)
end

local function crearSlider(titulo, minVal, maxVal, inicio, callback)
	local container = Instance.new("Frame", contentContainer)
	container.Size = UDim2.new(1, -8, 0, 38)
	container.BackgroundTransparency = 1

	local sliderTrack = Instance.new("TextButton", container)
	sliderTrack.Size = UDim2.new(1, -70, 1, 0)
	sliderTrack.BackgroundColor3 = THEME.BgCard
	sliderTrack.Text = ""
	sliderTrack.AutoButtonColor = false
	sliderTrack.ClipsDescendants = true
	Instance.new("UICorner", sliderTrack).CornerRadius = UDim.new(0, 8)

	local pctInicial = math.clamp((inicio - minVal) / (maxVal - minVal), 0, 1)

	local sliderFill = Instance.new("Frame", sliderTrack)
	sliderFill.Size = UDim2.new(pctInicial, 0, 1, 0)
	sliderFill.BackgroundColor3 = THEME.Accent
	sliderFill.BorderSizePixel = 0
	Instance.new("UICorner", sliderFill).CornerRadius = UDim.new(0, 8)

	local tLabel = Instance.new("TextLabel", sliderTrack)
	tLabel.Size = UDim2.new(1, -16, 1, 0)
	tLabel.Position = UDim2.new(0, 12, 0, 0)
	tLabel.BackgroundTransparency = 1
	tLabel.Text = titulo .. ": " .. tostring(inicio)
	tLabel.TextColor3 = THEME.TextMain
	tLabel.Font = Enum.Font.GothamBold
	tLabel.TextSize = 12
	tLabel.TextXAlignment = Enum.TextXAlignment.Left
	tLabel.ZIndex = 2

	local valBox = Instance.new("Frame", container)
	valBox.Size = UDim2.new(0, 60, 1, 0)
	valBox.Position = UDim2.new(1, -60, 0, 0)
	valBox.BackgroundColor3 = THEME.BgCard
	Instance.new("UICorner", valBox).CornerRadius = UDim.new(0, 8)

	local valLabel = Instance.new("TextLabel", valBox)
	valLabel.Size = UDim2.new(1, 0, 1, 0)
	valLabel.BackgroundTransparency = 1
	valLabel.Text = tostring(inicio)
	valLabel.TextColor3 = THEME.TextMain
	valLabel.Font = Enum.Font.GothamBold
	valLabel.TextSize = 13

	local arrastrando = false

	local function actualizar(input)
		local posX = math.clamp((input.Position.X - sliderTrack.AbsolutePosition.X) / sliderTrack.AbsoluteSize.X, 0, 1)
		sliderFill.Size = UDim2.new(posX, 0, 1, 0)

		local valor = math.floor(minVal + (maxVal - minVal) * posX)
		tLabel.Text = titulo .. ": " .. tostring(valor)
		valLabel.Text = tostring(valor)
		callback(valor)
	end

	sliderTrack.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			arrastrando = true
			actualizar(input)
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			arrastrando = false
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if arrastrando and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			actualizar(input)
		end
	end)
end

