local function togglePanel()
	panelAbierto = not panelAbierto
	if panelAbierto then
		mainFrame.Visible = true
		mainFrame.Size = UDim2.new(0, 0, 0, 0)
		mainFrame.Position = UDim2.new(0.5, 0, 0.5, 0)
		tween(mainFrame, 0.35, {
			Size = UDim2.new(0, 540, 0, 340),
			Position = UDim2.new(0.5, -270, 0.5, -170)
		}, Enum.EasingStyle.Back)
	else
		local a = tween(mainFrame, 0.25, {
			Size = UDim2.new(0, 0, 0, 0),
			Position = UDim2.new(0.5, 0, 0.5, 0)
		}, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
		a.Completed:Connect(function()
			if not panelAbierto then mainFrame.Visible = false end
		end)
	end
end

