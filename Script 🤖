-- === UTILIDADES UI Y ANIMACIONES ===
local function tween(obj, t, props, style, dir)
	style = style or Enum.EasingStyle.Quart
	dir = dir or Enum.EasingDirection.Out
	local a = TweenService:Create(obj, TweenInfo.new(t, style, dir), props)
	a:Play()
	return a
end

local function animarBoton(btn, colorNormal, colorHover, colorClick)
	colorNormal = colorNormal or btn.BackgroundColor3
	colorHover = colorHover or THEME.BgCardHover
	colorClick = colorClick or THEME.Accent2

	local origSize = btn.Size
	local stroke = btn:FindFirstChildOfClass("UIStroke")
	local origStrokeColor = stroke and stroke.Color or THEME.Accent

	btn.MouseEnter:Connect(function()
		tween(btn, 0.15, {BackgroundColor3 = colorHover}, Enum.EasingStyle.Quad)
		if stroke then tween(stroke, 0.15, {Color = THEME.Accent}, Enum.EasingStyle.Quad) end
	end)

	btn.MouseLeave:Connect(function()
		tween(btn, 0.15, {BackgroundColor3 = colorNormal}, Enum.EasingStyle.Quad)
		if stroke then tween(stroke, 0.15, {Color = origStrokeColor}, Enum.EasingStyle.Quad) end
	end)

	btn.MouseButton1Down:Connect(function()
		tween(btn, 0.08, {
			Size = UDim2.new(origSize.X.Scale, origSize.X.Offset - 3, origSize.Y.Scale, origSize.Y.Offset - 2),
			BackgroundColor3 = colorClick
		}, Enum.EasingStyle.Quad)
	end)

	btn.MouseButton1Up:Connect(function()
		tween(btn, 0.18, {
			Size = origSize,
			BackgroundColor3 = colorHover
		}, Enum.EasingStyle.Back)
	end)
end

