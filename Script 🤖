local function crearTarjetaToggle(parentContainer, titulo, sub, colorActivo)
	colorActivo = colorActivo or THEME.Accent
	local card = crearTarjetaBase(parentContainer, titulo, sub)

	local switchBg = Instance.new("TextButton", card)
	switchBg.Size = UDim2.new(0, 44, 0, 24)
	switchBg.Position = UDim2.new(1, -52, 0.5, -12)
	switchBg.BackgroundColor3 = Color3.fromRGB(20, 26, 36)
	switchBg.Text = ""
	switchBg.AutoButtonColor = false
	Instance.new("UICorner", switchBg).CornerRadius = UDim.new(0, 12)

	local switchStroke = Instance.new("UIStroke", switchBg)
	switchStroke.Color = Color3.fromRGB(45, 60, 80)
	switchStroke.Thickness = 1

	local knob = Instance.new("Frame", switchBg)
	knob.Size = UDim2.new(0, 18, 0, 18)
	knob.Position = UDim2.new(0, 3, 0.5, -9)
	knob.BackgroundColor3 = THEME.Accent
	knob.BorderSizePixel = 0
	Instance.new("UICorner", knob).CornerRadius = UDim.new(0, 9)

	local estado = false

	local function setEstado(nuevoEstado)
		estado = nuevoEstado
		if estado then
			tween(switchBg, 0.2, {BackgroundColor3 = colorActivo}, Enum.EasingStyle.Quart)
			switchStroke.Color = colorActivo
			knob.BackgroundColor3 = Color3.fromRGB(12, 14, 22)
			tween(knob, 0.2, {Position = UDim2.new(1, -21, 0.5, -9)}, Enum.EasingStyle.Back)
		else
			tween(switchBg, 0.2, {BackgroundColor3 = Color3.fromRGB(20, 26, 36)}, Enum.EasingStyle.Quart)
			switchStroke.Color = Color3.fromRGB(45, 60, 80)
			knob.BackgroundColor3 = THEME.Accent
			tween(knob, 0.2, {Position = UDim2.new(0, 3, 0.5, -9)}, Enum.EasingStyle.Quart)
		end
	end

	return card, switchBg, setEstado
end

