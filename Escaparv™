local function crearMarcador(cf, color)
	quitarMarcador()
	local model = Instance.new("Model")
	model.Name = "XZ_TP_Marker_Premium"

	local part = Instance.new("Part")
	part.Size = Vector3.new(1.8, 1.8, 1.8)
	part.CFrame = cf * CFrame.new(0, 2.8, 0)
	part.Anchored = true
	part.CanCollide = false
	part.Material = Enum.Material.Neon
	part.Color = color
	part.Transparency = 0.15
	part.Parent = model

	local mesh = Instance.new("SpecialMesh", part)
	mesh.MeshType = Enum.MeshType.FileMesh
	mesh.MeshId = "rbxassetid://10337144"
	mesh.Scale = Vector3.new(1.4, 2.2, 1.4)

	local ground = Instance.new("Part")
	ground.Size = Vector3.new(0.6, 0.1, 0.6)
	ground.CFrame = cf
	ground.Anchored = true
	ground.Transparency = 1
	ground.CanCollide = false
	ground.Parent = model

	local a0 = Instance.new("Attachment", part)
	local a1 = Instance.new("Attachment", ground)

	local beam = Instance.new("Beam", part)
	beam.Attachment0 = a0
	beam.Attachment1 = a1
	beam.Color = ColorSequence.new(color, THEME.Accent2)
	beam.Width0 = 1.0
	beam.Width1 = 0.05
	beam.FaceCamera = true

	local hl = Instance.new("Highlight", model)
	hl.FillColor = color
	hl.OutlineColor = Color3.new(1,1,1)
	hl.FillTransparency = 0.4

	model.Parent = Workspace
	marcador = model

	local ang = 0
	rotacion = RunService.RenderStepped:Connect(function(dt)
		if part and part.Parent then
			ang = ang + dt * 85
			part.CFrame = (cf * CFrame.new(0, 2.8 + math.sin(os.clock()*3)*0.35, 0)) * CFrame.Angles(0, math.rad(ang), 0)
		end
	end)
end

