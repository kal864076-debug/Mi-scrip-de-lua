local accumulatedTime = 0
RunService.RenderStepped:Connect(function(dt)
	local fps = math.floor(1 / dt)
	local ping = math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue())
	statsLabel.Text = string.format("Ping: %d ms | FPS: %d", ping, fps)

	if antiAfkEnabled then
		accumulatedTime = accumulatedTime + dt
		afkSecondsElapsed = afkSecondsElapsed + dt

		-- Formatear AFK Time (HH:MM:SS)
		local hours = math.floor(accumulatedTime / 3600)
		local mins = math.floor((accumulatedTime % 3600) / 60)
		local secs = math.floor(accumulatedTime % 60)
		afkTimerLabel.Text = string.format("AFK Time: %02d:%02d:%02d", hours, mins, secs)

		-- Cuenta atrás Next Click (18 min = 1080s)
		local timeLeft = math.max(0, nextClickSeconds - math.floor(afkSecondsElapsed % nextClickSeconds))
		local nMin = math.floor(timeLeft / 60)
		local nSec = timeLeft % 60
		nextClickLabel.Text = string.format("Next click: %02d:%02d", nMin, nSec)

		if afkSecondsElapsed >= nextClickSeconds then
			afkSecondsElapsed = 0
			pcall(function()
				VirtualUser:Button1Down(Vector2.new(0,0), workspace.CurrentCamera.CFrame)
				VirtualUser:Button1Up(Vector2.new(0,0), workspace.CurrentCamera.CFrame)
			end)
		end
	else
		afkTimerLabel.Text = "AFK Time: Pausado"
		nextClickLabel.Text = "Next click: Inactivo"
	end
end)

