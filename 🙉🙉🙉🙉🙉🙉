end

local cacheEtapas = {}

local function obtenerPosicionEtapa(numMundo, numEtapa)
	local cacheKey = numMundo .. "_" .. numEtapa
	if cacheEtapas[cacheKey] then return cacheEtapas[cacheKey] end

	local ok, res = pcall(function()
		local map = Workspace:FindFirstChild("Map") or Workspace
		local world = map:FindFirstChild("World" .. numMundo) or map:FindFirstChild("World " .. numMundo)
		if not world then return nil end

		local stages = world:FindFirstChild("Stages")
		if not stages then return nil end

		local stageObj = stages:FindFirstChild("Stage" .. numEtapa) or stages:FindFirstChild("Stage " .. numEtapa) or stages:FindFirstChild("Stage_" .. numEtapa)
		if not stageObj then return nil end

		local winObj
		if numMundo == 1 then
			winObj = stageObj:FindFirstChild("VipWin") and stageObj.VipWin:FindFirstChild("UI")
		elseif numMundo == 2 then
			winObj = stageObj:FindFirstChild("FinalDestination")
			winObj = winObj and winObj:FindFirstChild("VipWin") and winObj.VipWin:FindFirstChild("UI")
		elseif numMundo == 3 then
			winObj = stageObj:FindFirstChild("VipWin") and stageObj.VipWin:FindFirstChild("UI")
		elseif numMundo == 4 then
			winObj = stageObj:FindFirstChild("VipWin") and stageObj.VipWin:FindFirstChild("UI")
		elseif numMundo == 5 then
			winObj = stageObj:FindFirstChild("StageEnd") and stageObj.StageEnd:FindFirstChild("VipWin") and stageObj.StageEnd.VipWin:FindFirstChild("UI")
		end

		if not winObj then
			winObj = stageObj:FindFirstChild("VipWin", true) or stageObj:FindFirstChild("NormalWin", true) or stageObj:FindFirstChild("UI", true) or stageObj
		end

		if not winObj then return nil end
		if winObj:IsA("Model") then
			local p = winObj:FindFirstChildWhichIsA("BasePart", true)
			return p and p.CFrame or winObj:GetPivot()
		elseif winObj:IsA("BasePart") then
			return winObj.CFrame
		end
		return nil
	end)

	if ok and res then
		local finalPos = res + Vector3.new(0, 3.5, 0)
		cacheEtapas[cacheKey] = finalPos
		return finalPos
	end
	return nil
end

local function MoverAEtapa(numMundo, numEtapa)
	local root = getRoot()
	if not root then return end
	local pos = obtenerPosicionEtapa(numMundo, numEtapa)
	if pos then
		root.AssemblyLinearVelocity = Vector3.zero
		root.AssemblyAngularVelocity = Vector3.zero
		root.CFrame = pos
	end
end

