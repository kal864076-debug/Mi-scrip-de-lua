	else
		local a = tween(mainFrame, 0.2, {Size = UDim2.new(0, 0, 0, 0), Position = UDim2.new(0.5, 0, 0.5, 0)}, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
		a.Completed:Connect(function() if not panelAbierto then mainFrame.Visible = false end end)
	end
end

