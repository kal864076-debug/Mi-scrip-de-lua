local function getRoot()
	local c = LocalPlayer.Character
	return c and c:FindFirstChild("HumanoidRootPart")
end

local function obtenerPosicionFinalZona(numMundo)
	local ok, res = pcall(function()
		local map = Workspace:FindFirstChild("Map")
		if not map then return nil end

		-- RUTA ESPECÍFICA PARA MUNDO 5:
		if numMundo == 5 then
			local world5 = map:FindFirstChild("World5") or map:FindFirstChild("World 5")
			if world5 then
				local stages = world5:FindFirstChild("Stages")
				if stages then
					local stage6 = stages:FindFirstChild("Stage6")
					if stage6 then
						local normalWin = stage6:FindFirstChild("NormalWin")
						if normalWin then
							local uiObj = normalWin:FindFirstChild("UI") or normalWin
							if uiObj:IsA("Model") then return uiObj:GetPivot() end
							if uiObj:IsA("BasePart") then return uiObj.CFrame end
						end
					end
				end
			end
		end

		-- RUTA GENERAL PARA OTROS MUNDOS:
		local world = map:FindFirstChild("World" .. numMundo) or map:FindFirstChild("World " .. numMundo)
		if not world then return nil end

		local normalWin = world:FindFirstChild("NormalWin", true)
		local uiObj = (normalWin and normalWin:FindFirstChild("UI")) or normalWin or world:FindFirstChild("UI", true)

		if uiObj then
			if uiObj:IsA("Model") then
				return uiObj:GetPivot()
			elseif uiObj:IsA("BasePart") then
				return uiObj.CFrame
			end
		end
		return nil
	end)

	if ok and res then
		return res + Vector3.new(0, 3, 0)
	end
	return nil
end

local mundosData = {}

local function desactivarOtrosMundos(idxExcluido)
	for i = 1, 5 do
		if i ~= idxExcluido and mundosData[i] then
			if mundosData[i].bucle then
				mundosData[i].bucle = false
				mundosData[i].setSwitch(false)
				mundosData[i].fI.Visible = false
				if mundosData[i].hilo then
					task.cancel(mundosData[i].hilo)
					mundosData[i].hilo = nil
				end
			end
		end
	end
end

-- Generar tarjetas de Mundo 1 a Mundo 5
for i = 1, 5 do
	local colorTema = (i % 2 == 0) and THEME.Accent2 or THEME.Accent
	local card, switchBtn, setSwitch = crearTarjetaToggle("Mundo " .. i, "Final Zona Directo", colorTema)
	local fI, input = crearTarjetaIntervalo()

	mundosData[i] = {
		bucle = false,
		hilo = nil,
		setSwitch = setSwitch,
		fI = fI,
		input = input
	}

	switchBtn.MouseButton1Click:Connect(function()
		local data = mundosData[i]
		
		data.bucle = not data.bucle
		setSwitch(data.bucle)

		if data.bucle then
			desactivarOtrosMundos(i)
			data.fI.Visible = true

			data.hilo = task.spawn(function()
				while data.bucle do
					local root = getRoot()
					local pos = obtenerPosicionFinalZona(i)
					if root and pos then
						root.CFrame = pos
					end

					local t = tonumber(data.input.Text) or tonumber(inputVelocidadGlobal.Text) or 0.5
					if t < 0.05 then t = 0.05 end
					local pasos = math.max(1, math.floor(t * 10))

					for _ = pasos, 1, -1 do
						if not data.bucle then break end
						task.wait(t / pasos)
					end
				end
			end)

			notificar("Auto TP M" .. i, "TP Directo Activado", "success", 3)
		else
			data.fI.Visible = false
			if data.hilo then
				task.cancel(data.hilo)
				data.hilo = nil
			end
			notificar("Auto TP M" .. i, "Desactivado", "warning", 3)
		end
	end)
end

