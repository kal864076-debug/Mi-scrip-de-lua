local function getRoot()
	local c = LocalPlayer.Character
	return c and c:FindFirstChild("HumanoidRootPart")
end

-- Obtener Hitbox de Checkpoints del 1 al 9
local function obtenerHitboxCheckpoint(numEtapa)
	local ok, res = pcall(function()
		local checkpointObj = Workspace.Map.Checkpoints.World5:FindFirstChild("Checkpoint" .. numEtapa)
		if checkpointObj then
			local hitbox = checkpointObj:FindFirstChild("Hitbox")
			if hitbox and hitbox:IsA("BasePart") then
				return hitbox.CFrame + Vector3.new(0, 3, 0)
			end
		end
		return nil
	end)
	if ok and res then return res end
	return nil
end

-- Obtener destino final para el Autofarm: Stage9.StageEnd.NormalWin.UI
local function obtenerPosicionStage9UI()
	local ok, res = pcall(function()
		local uiObj = Workspace.Map.World5.Stages.Stage9.StageEnd.NormalWin.UI
		if uiObj:IsA("BasePart") then
			return uiObj.CFrame + Vector3.new(0, 3, 0)
		elseif uiObj:IsA("Model") then
			local p = uiObj:FindFirstChildWhichIsA("BasePart", true)
			return p and (p.CFrame + Vector3.new(0, 3, 0)) or uiObj:GetPivot()
		end
		return nil
	end)
	if ok and res then return res end
	return nil
end

local teleguiadoActivo = false
local hiloSecuencia = nil

local function actualizarSwitchVisual(estado)
	if estado then
		tween(switchBg, 0.22, {BackgroundColor3 = THEME.Success})
		switchStroke.Color = THEME.Success
		knob.BackgroundColor3 = THEME.BgCard
		tween(knob, 0.22, {Position = UDim2.new(1, -21, 0.5, -9)})
	else
		tween(switchBg, 0.22, {BackgroundColor3 = Color3.fromRGB(35, 45, 35)})
		switchStroke.Color = Color3.fromRGB(60, 80, 60)
		knob.BackgroundColor3 = THEME.TextSub
		tween(knob, 0.22, {Position = UDim2.new(0, 3, 0.5, -9)})
	end
end

switchBg.MouseButton1Click:Connect(function()
	teleguiadoActivo = not teleguiadoActivo
	actualizarSwitchVisual(teleguiadoActivo)

	if teleguiadoActivo then
		notificar("SK OMEGA", "Iniciando recorrido hasta Checkpoint 9...", "success", 3)
		
		hiloSecuencia = task.spawn(function()
			while teleguiadoActivo do
				-- 1. Recorrer secuencialmente del Checkpoint 1 al 9 (Velocidad de TP a 0.5 segundos)
				for i = 1, 9 do
					if not teleguiadoActivo then break end
					local pos = obtenerHitboxCheckpoint(i)
					local root = getRoot()
					if root and pos then
						root.AssemblyLinearVelocity = Vector3.zero
						root.AssemblyAngularVelocity = Vector3.zero
						root.CFrame = pos
					end
					task.wait(0.5)
				end

				-- 2. Quedarse fijo haciendo autofarm en NormalWin.UI
				notificar("AUTOFARM", "¡Llegó a la última etapa! Fijado en NormalWin.UI", "success", 2)
				while teleguiadoActivo do
					local finalRoot = getRoot()
					local finalPos = obtenerPosicionStage9UI()
					if finalRoot and finalPos then
						finalRoot.AssemblyLinearVelocity = Vector3.zero
						finalRoot.AssemblyAngularVelocity = Vector3.zero
						finalRoot.CFrame = finalPos
					end
					task.wait(0.3)
				end
			end
		end)
	else
		if hiloSecuencia then
			task.cancel(hiloSecuencia)
			hiloSecuencia = nil
		end
		notificar("SK OMEGA", "Teleguiado desactivado.", "warning", 2)
	end
end)

local function togglePanel()
	panelAbierto = not panelAbierto
	if panelAbierto then
		mainFrame.Visible = true
		mainFrame.Size = UDim2.new(0, 0, 0, 0)
		mainFrame.Position = UDim2.new(0.5, 0, 0.5, 0)
		tween(mainFrame, 0.35, {
			Size = UDim2.new(0, 360, 0, 220),
			Position = UDim2.new(0.5, -180, 0.5, -110)
		}, Enum.EasingStyle.Back)
	else
		local a = tween(mainFrame, 0.25, {
			Size = UDim2.new(0, 0, 0, 0),
			Position = UDim2.new(0.5, 0, 0.5, 0)
		}, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
		a.Completed:Connect(function()
			if not panelAbierto then mainFrame.Visible = false end
		end)
	end
end

